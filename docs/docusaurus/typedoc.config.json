{
    "$schema": "https://typedoc-plugin-markdown.org/schema.json",
    "classPropertiesFormat": "table",
    "cleanOutputDir": true,
    "entryFileName": "README.md",
    "entryPoints": [
        "../../src/plugin.ts"
    ],
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "formatWithPrettier": true,
    "hideBreadcrumbs": true,
    "hideGenerator": true,
    "interfacePropertiesFormat": "table",
    "name": "eslint-plugin-copilot API reference",
    "navigation": {
        "includeCategories": true,
        "includeFolders": true,
        "includeGroups": true
    },
    "navigationJson": "./site-docs/developer/api/navigation.json",
    "out": "./site-docs/developer/api",
    "parametersFormat": "table",
    "plugin": [
        "typedoc-plugin-markdown",
        "./typedoc-plugins/hashToBangLinks.mjs",
        "./typedoc-plugins/prefixDocLinks.mjs"
    ],
    "readme": "none",
    "router": "member",
    "tsconfig": "./tsconfig.typedoc.json",
    "typeDeclarationFormat": "table",
    "useCodeBlocks": true
}
