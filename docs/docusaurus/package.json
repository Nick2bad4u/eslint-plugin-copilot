{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@eslint-plugin-copilot/docs",
    "version": "0.1.0",
    "private": true,
    "description": "Docusaurus documentation site for eslint-plugin-copilot.",
    "keywords": [
        "copilot",
        "documentation",
        "docusaurus",
        "eslint",
        "eslint-plugin",
        "github-copilot"
    ],
    "homepage": "https://nick2bad4u.github.io/eslint-plugin-copilot/",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/eslint-plugin-copilot/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/eslint-plugin-copilot.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "main": "docusaurus.config.ts",
    "files": [
        "build"
    ],
    "scripts": {
        "build": "npm run docs:api && docusaurus build",
        "build:fast": "npm run docs:api && cross-env DOCUSAURUS_ENABLE_EXPERIMENTAL=true docusaurus build",
        "build:local": "npm run docs:api:local && docusaurus build",
        "clear": "docusaurus clear",
        "deploy": "docusaurus deploy",
        "docs:api": "node ../../scripts/run-typedoc-docs.mjs --config typedoc.config.json",
        "docs:api:local": "node ../../scripts/run-typedoc-docs.mjs --config typedoc.local.config.mjs",
        "docusaurus": "docusaurus",
        "serve": "docusaurus serve",
        "start": "npm run docs:api:local && docusaurus start --host localhost",
        "start:devtools": "npm run docs:api:local && cross-env DOCUSAURUS_BASE_URL=/ docusaurus start --host localhost",
        "type:css": "npx typed-css-modules .\\src",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "write-heading-ids": "docusaurus write-heading-ids",
        "write-translations": "docusaurus write-translations"
    },
    "dependencies": {
        "@docusaurus/core": "^3.9.2",
        "@docusaurus/faster": "^3.9.2",
        "@docusaurus/plugin-content-docs": "^3.9.2",
        "@docusaurus/plugin-pwa": "^3.9.2",
        "@docusaurus/preset-classic": "^3.9.2",
        "@docusaurus/theme-mermaid": "^3.9.2",
        "@docusaurus/types": "^3.9.2",
        "@easyops-cn/docusaurus-search-local": "^0.55.1",
        "clsx": "^2.1.1",
        "prism-react-renderer": "^2.4.1"
    },
    "devDependencies": {
        "@docusaurus/module-type-aliases": "^3.9.2",
        "@docusaurus/tsconfig": "^3.9.2",
        "@eslint/config-inspector": "^1.5.0",
        "@mdx-js/react": "^3.1.1",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "docusaurus-plugin-image-zoom": "^3.0.1",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-github-btn": "^1.4.0",
        "typed-css-modules": "^0.9.1",
        "typedoc-plugin-coverage": "^4.0.2",
        "typedoc-plugin-dt-links": "^2.0.47",
        "typedoc-plugin-external-package-links": "^0.2.0",
        "typedoc-plugin-markdown": "^4.11.0",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typedoc-plugin-missing-exports": "^4.1.2",
        "typedoc-plugin-remark": "^2.0.1",
        "typedoc-plugin-rename-defaults": "^0.7.3",
        "typedoc-plugin-replace-text": "^4.2.0",
        "typescript": "^6.0.2"
    },
    "peerDependencies": {
        "react": "^19.2.4",
        "react-dom": "^19.2.4"
    },
    "packageManager": "npm@11.12.1",
    "engines": {
        "node": ">=22.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.0.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=11.0.0",
            "onFail": "error"
        }
    }
}
